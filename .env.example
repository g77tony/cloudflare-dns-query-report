# Cloudflare dashboard: Workers -> Settings -> Variables and Secrets.
# Do not commit real values. Secrets should be stored as Encrypted values.

# Required. Cloudflare account ID.
ACCOUNT_ID=your-cloudflare-account-id

# Required. API token with permission to list zones and read DNS analytics
# for every zone in the account (Zone.Zone:Read and Zone.Analytics:Read).
CF_API_TOKEN=your-cloudflare-api-token

# Required. Password for HTTP Basic Auth on the Worker URL.
AUTH_PASS=change-me-to-a-long-random-password

# Optional. Basic Auth username. Default: report-dns-query
AUTH_USER=report-dns-query

# Required. S3-compatible credentials (Wasabi, AWS S3, R2, MinIO, ...).
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# Required. Destination bucket (must already exist).
S3_BUCKET=your-dns-reports-bucket

# Required. Region used in SigV4 signing, e.g. eu-south-1 or us-east-1.
S3_REGION=eu-south-1

# Required. S3 endpoint host without scheme, e.g. s3.eu-south-1.wasabisys.com
# or s3.eu-south-1.amazonaws.com
S3_HOST=s3.eu-south-1.wasabisys.com
